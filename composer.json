{
  "name": "chamber-orchestra/metadata-bundle",
  "type": "symfony-bundle",
  "description": "Symfony bundle for extending Doctrine ORM entities with custom attribute-driven metadata — cacheable mapping, embedded entity support, and autoconfigured drivers",
  "keywords": [
    "symfony",
    "symfony-bundle",
    "doctrine",
    "doctrine-orm",
    "doctrine-extensions",
    "orm",
    "metadata",
    "php-attributes",
    "mapping",
    "entity",
    "embeddable",
    "extension"
  ],
  "homepage": "https://github.com/chamber-orchestra/metadata-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Andrew Lukin",
      "email": "lukin.andrej@gmail.com",
      "homepage": "https://github.com/wtorsi",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/chamber-orchestra/metadata-bundle/issues",
    "source": "https://github.com/chamber-orchestra/metadata-bundle"
  },
  "require": {
    "php": "^8.5",
    "symfony/dependency-injection": "8.0.*",
    "symfony/config": "8.0.*",
    "symfony/framework-bundle": "8.0.*",
    "symfony/runtime": "8.1.*",
    "doctrine/orm": "3.6.*",
    "doctrine/common": "^3.0",
    "doctrine/doctrine-bundle": "3.2.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "symfony/test-pack": "^1.2",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94"
  },
  "autoload": {
    "psr-4": {
      "ChamberOrchestra\\MetadataBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.0.*"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "analyse": "vendor/bin/phpstan analyse",
    "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs-fix": "vendor/bin/php-cs-fixer fix"
  }
}
